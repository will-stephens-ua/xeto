// ModbusAddr contains all info required to connect to a modbus point
// Only supports Modicon (1-based) addressing format. Raw 0-based PDU addresses are not supported.
//
// Fields:
// - **addr**: Modicon address string. Leading digit selects the type/function;
//   the remaining 4-5 digits are the 1-based register number:
//     0xxxx  Coil
//     1xxxx  Discrete Input
//     3xxxx  Input Register
//     4xxxx  Holding Register
// - **encoding**: Data format for interpretation.
// - **bitIndex**: (0-15) Optional bit position within a register. Only meaningful when encoding is bit.
// - **access**: "r" (default), "rw" (Read/Write), or "w" (Write Only).
// - **scale**: Optional ordered list of scale operations applied to the raw value.
// - **byteOrder**: Optional, defines endianness for multi-register values. Defaults to network byte order when omitted.
//
// Example: { "addr": "40001", "encoding": "u2", "access": "rw", "scale": [{"op":"/", "factor":10}] }
ModbusAddr: ProtocolAddr {
  addr:  Str <pattern:"[0134]\\d{4,5}">   // Must follow Modicon addressing rules. Valid addr values are as follows: 00001-065536, 10001-165536, 30001-365536, 40001-465536.
  encoding: ModbusEncoding                // Specifies data representation format
  bitIndex: Int? <minVal:0, maxVal:15>    // Optional bit index within a register. Only used when encoding is bit.
  access: ModbusAccess "r"                // Read/write access
  scale: List<of:ModbusScaleOp>?          // Ordered list of operations applied sequentially, left-to-right, with NO operator precedence.
                                          // e.g. [{op:"+", factor:32768}, {op:"/", factor:10}] means (raw + 32768) / 10. Writable points invert by reversing the list
                                          // and swapping + <-> - and * <-> /.
  byteOrder: ModbusByteOrder?             // Defines endianness for multi-register values. Defaults to network byte order when omitted.
}

// A single scale operation: apply factor to the running value using op.
// Operations are applied in list order with no precedence.
ModbusScaleOp: Dict {
  op:     ModbusScaleOpType   // +, -, *, or /
  factor: Number              // numeric constant operand
}

// Scale operation types. Programmatic names are identifier-legal (add/sub/mul/div),
// but keys are the symbols '+','-','*','/'.
ModbusScaleOpType: Enum {
  add <key:"+">  // running value + factor   (inverse: -)
  sub <key:"-">  // running value - factor   (inverse: +)
  mul <key:"*">  // running value * factor   (inverse: /)
  div <key:"/">  // running value / factor   (inverse: *)
}

// ModbusAccess specifies read/write access for a modbus point
ModbusAccess: Enum {
  r   // Read Only
  rw  // Read/Write
  w   // Write Only
}

// ModbusEncoding specifies the data type and encoding for a modbus point
ModbusEncoding: Enum {
  bit // Bool
  u1  // Unsigned  8-bit Int
  u2  // Unsigned 16-bit Int
  u4  // Unsigned 32-bit Int
  s1  // Signed  8-bit Int
  s2  // Signed 16-bit Int
  s4  // Signed 32-bit Int
  s8  // Signed 64-bit Int
  f4  // 32-bit Float
  f8  // 64-bit Float
}

// Specifies byte and word order for a modbus point
ModbusByteOrder: Enum {
  be  // Big endian or network byte order
  le  // Little endian both byte and word order
  leb // Little endian byte order
  lew // Little endian word order
}

